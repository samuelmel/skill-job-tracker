# Copie para .env e ajuste. Nenhum segredo real deve ser versionado.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/skilometer
HTTP_TIMEOUT=20
HTTP_MAX_RETRIES=3
USER_AGENT=Skilometer/0.1 (+mailto:seu-contato@exemplo.com)
PER_DOMAIN_CONCURRENCY=4
PER_DOMAIN_MIN_INTERVAL=0.2
LOG_LEVEL=INFO
DEDUP_MERGE_THRESHOLD=0.90
DEDUP_REVIEW_THRESHOLD=0.75
DEDUP_URL_MIN_TITLE_SIMILARITY=0.6
RECONCILE_MAX_CLOSE_RATIO=0.5
RECONCILE_MIN_BLOCK_COUNT=5
RECONCILE_MISSES_TO_CLOSE=2
RECONCILE_GRACE_HOURS=12
